config global 'global'
	option account_email 'email@example.org'
	option log_level 'info'
	option debug '0'

config cert 'dns_example'
	option enabled '0'
	option validation_method 'dns'
	option dns 'dns_cf'
	list domains 'example.com'
	list domains '*.example.com'
	option key_type 'ec256'
	option staging '0'

config cert 'webroot_example'
	option enabled '0'
	option validation_method 'webroot'
	option webroot '/var/run/cert/challenge/'
	list domains 'router.example.com'
	option key_type 'ec256'
	option staging '0'
