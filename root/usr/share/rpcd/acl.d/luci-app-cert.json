{
	"luci-app-cert": {
		"description": "Grant UCI and ubus access for luci-app-cert",
		"read": {
			"file": {
				"/proc/sys/kernel/hostname": [ "read" ],
				"/etc/ssl/cert/*": [ "read" ]
			},
			"uci": [ "cert", "ddns" ],
			"ubus": {
				"luci.cert": [ "get_status", "get_dnsinfo", "get_logs", "service_action" ]
			}
		},
		"write": {
			"uci": [ "cert" ]
		}
	}
}
